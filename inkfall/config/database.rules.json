{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['displayName', 'level'])",
          "displayName": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
          },
          "level": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999 && newData.val() % 1 === 0"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "schemaVersion": {
          ".validate": "newData.val() === 2"
        },
        "selectedClass": {
          ".validate": "newData.val() === 'knight' || newData.val() === 'mage'"
        },
        "characters": {
          "$classId": {
            ".validate": "($classId === 'knight' || $classId === 'mage') && newData.hasChildren(['level', 'xp', 'skillPoints', 'soloRun']) && newData.child('soloRun/heroClass').val() === $classId",
            "level": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999 && newData.val() % 1 === 0"
            },
            "xp": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999999 && newData.val() % 1 === 0"
            },
            "skillPoints": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 === 0"
            },
            "skills": {
              ".validate": "newData.hasChildren()",
              "$skillId": {
                ".validate": "$skillId.matches(/^(blade|arcane|bastion|shadow|wealth|band)[1-4]$/) && newData.isBoolean() && newData.val() === true"
              }
            },
            "soloRun": {
              ".validate": "newData.hasChildren(['heroClass', 'gold', 'lives', 'wave'])",
              "heroClass": {
                ".validate": "newData.val() === 'knight' || newData.val() === 'mage'"
              },
              "gold": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
              },
              "lives": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              },
              "wave": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 === 0"
              },
              "heroX": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 940"
              },
              "heroY": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600"
              },
              "towers": {
                ".validate": "newData.hasChildren()",
                "$towerId": {
                  ".validate": "$towerId.matches(/^tower_([0-9]|[1-9][0-9]|1[0-9][0-9])$/) && newData.hasChildren(['type', 'x', 'y', 'level'])",
                  "type": {
                    ".validate": "newData.val() === 'arrow' || newData.val() === 'frost' || newData.val() === 'cannon' || newData.val() === 'antiair'"
                  },
                  "x": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 940"
                  },
                  "y": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600"
                  },
                  "level": {
                    ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100 && newData.val() % 1 === 0"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
