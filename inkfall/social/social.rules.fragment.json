{
  "rules": {
    "social": {
      ".read": false,
      ".write": false,
      "relationships": {
        ".read": false,
        ".write": false
      },
      "friends": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "requests": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "sentRequests": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "blocks": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "profiles": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || ((root.child('social/relationships').child(auth.uid).child($uid).child('status').val() === 'friends' || root.child('social/relationships').child($uid).child(auth.uid).child('status').val() === 'friends') && root.child('social/privacy').child($uid).child('profile').val() === 'friends'))",
          ".write": false
        }
      },
      "characterViews": {
        "$uid": {
          "$classId": {
            ".read": "($classId === 'knight' || $classId === 'mage') && (auth != null && (auth.uid === $uid || ((root.child('social/relationships').child(auth.uid).child($uid).child('status').val() === 'friends' || root.child('social/relationships').child($uid).child(auth.uid).child('status').val() === 'friends') && root.child('social/privacy').child($uid).child('characters').val() === 'friends')))",
            ".write": false
          }
        }
      },
      "privacy": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['profile','characters'])",
          "profile": {
            ".validate": "newData.val() === 'private' || newData.val() === 'friends'"
          },
          "characters": {
            ".validate": "newData.val() === 'private' || newData.val() === 'friends'"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "presence": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || ((root.child('social/relationships').child(auth.uid).child($uid).child('status').val() === 'friends' || root.child('social/relationships').child($uid).child(auth.uid).child('status').val() === 'friends') && root.child('social/presencePrivacy').child($uid).val() === 'friends'))",
          ".write": false,
          "connections": {
            "$connectionId": {
              ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('social/presencePrivacy').child($uid).val() === 'friends')",
              ".validate": "$connectionId.matches(/^[-A-Za-z0-9_]{20}$/) && newData.hasChildren(['online','updatedAt'])",
              "online": {
                ".validate": "newData.val() === true"
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "presencePrivacy": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.val() === 'private' || newData.val() === 'friends'"
        }
      },
      "invites": {
        ".read": false,
        ".write": false
      }
    }
  }
}
