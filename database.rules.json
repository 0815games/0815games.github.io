{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['displayName','level'])",
          "displayName": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
          },
          "level": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999 && newData.val() % 1 === 0"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "schemaVersion": {
          ".validate": "newData.val() === 2"
        },
        "selectedClass": {
          ".validate": "newData.val() === 'knight' || newData.val() === 'mage'"
        },
        "characters": {
          "$classId": {
            ".validate": "($classId === 'knight' || $classId === 'mage') && newData.hasChildren(['level','xp','skillPoints','soloRun']) && newData.child('soloRun/heroClass').val() === $classId",
            "level": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999 && newData.val() % 1 === 0"
            },
            "xp": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999999 && newData.val() % 1 === 0"
            },
            "skillPoints": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 === 0"
            },
            "skills": {
              ".validate": "newData.hasChildren()",
              "$skillId": {
                ".validate": "$skillId.matches(/^(blade|arcane|bastion|shadow|wealth|band)[1-4]$/) && newData.isBoolean() && newData.val() === true"
              }
            },
            "soloRun": {
              ".validate": "newData.hasChildren(['heroClass','gold','lives','wave'])",
              "heroClass": {
                ".validate": "newData.val() === 'knight' || newData.val() === 'mage'"
              },
              "gold": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
              },
              "lives": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              },
              "wave": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 === 0"
              },
              "heroX": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 940"
              },
              "heroY": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600"
              },
              "towers": {
                ".validate": "newData.hasChildren()",
                "$towerId": {
                  ".validate": "$towerId.matches(/^tower_([0-9]|[1-9][0-9]|1[0-9][0-9])$/) && newData.hasChildren(['type','x','y','level'])",
                  "type": {
                    ".validate": "newData.val() === 'arrow' || newData.val() === 'frost' || newData.val() === 'cannon' || newData.val() === 'antiair'"
                  },
                  "x": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 940"
                  },
                  "y": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600"
                  },
                  "level": {
                    ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100 && newData.val() % 1 === 0"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "save": {
          ".validate": "newData.hasChildren(['gold','lives','wave','skillPoints'])",
          "heroClass": {
            ".validate": "newData.val() === 'knight' || newData.val() === 'mage'"
          },
          "gold": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
          },
          "lives": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "wave": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 === 0"
          },
          "heroX": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 940"
          },
          "heroY": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600"
          },
          "towers": {
            ".validate": "newData.hasChildren()",
            "$towerId": {
              ".validate": "$towerId.matches(/^tower_([0-9]|[1-9][0-9]|1[0-9][0-9])$/) && newData.hasChildren(['type','x','y','level'])",
              "type": {
                ".validate": "newData.val() === 'arrow' || newData.val() === 'frost' || newData.val() === 'cannon' || newData.val() === 'antiair'"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 940"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600"
              },
              "level": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100 && newData.val() % 1 === 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          },
          "skillPoints": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 === 0"
          },
          "skills": {
            ".validate": "newData.hasChildren()",
            "$skillId": {
              ".validate": "$skillId.matches(/^(blade|arcane|bastion|shadow|wealth|band)[1-4]$/) && newData.isBoolean() && newData.val() === true"
            }
          }
        },
        "diagnostic": {
          ".validate": "newData.hasChildren(['test','time'])",
          "test": {
            ".validate": "newData.isBoolean()"
          },
          "time": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('host/uid').val() === auth.uid && !newData.child('guest').exists() && newData.child('status').val() === 'waiting') || (data.exists() && data.child('host/uid').val() === auth.uid && !newData.exists()))",
        ".validate": "$code.matches(/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{8}$/) && newData.hasChildren(['host','status','createdAt']) && (!newData.child('guest').exists() || newData.child('guest/uid').val() !== newData.child('host/uid').val())",
        "host": {
          ".validate": "newData.hasChildren(['uid','name','heroClass','ready','online'])",
          "uid": {
            ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && newData.val() === data.val()))"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
          },
          "heroClass": {
            ".write": "auth != null && auth.uid === data.parent().child('uid').val() && data.parent().parent().child('status').val() === 'waiting' && data.parent().child('ready').val() === false && newData.exists()",
            ".validate": "newData.val() === 'knight' || newData.val() === 'mage'"
          },
          "ready": {
            ".write": "auth != null && auth.uid === data.parent().child('uid').val() && newData.exists()",
            ".validate": "newData.isBoolean()"
          },
          "online": {
            ".write": "auth != null && auth.uid === data.parent().child('uid').val() && newData.exists()",
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "guest": {
          ".write": "auth != null && auth.uid !== data.parent().child('host/uid').val() && ((data.exists() && data.child('uid').val() === auth.uid) || (!data.exists() && data.parent().child('status').val() === 'waiting' && data.parent().child('host/online').val() === true && newData.child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['uid','name','heroClass','ready','online']) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && newData.child('uid').val() === data.child('uid').val())) && (!data.exists() || newData.child('heroClass').val() === data.child('heroClass').val() || (data.parent().child('status').val() === 'waiting' && data.child('ready').val() === false && newData.child('ready').val() === false))",
          "uid": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
          },
          "heroClass": {
            ".validate": "newData.val() === 'knight' || newData.val() === 'mage'"
          },
          "ready": {
            ".validate": "newData.isBoolean()"
          },
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "status": {
          ".write": "auth != null && data.parent().child('host/uid').val() === auth.uid && (newData.val() === 'waiting' || (newData.val() === 'prepared' && data.parent().child('host/ready').val() === true && data.parent().child('guest/ready').val() === true && data.parent().child('host/online').val() === true && data.parent().child('guest/online').val() === true))",
          ".validate": "newData.val() === 'waiting' || newData.val() === 'prepared'"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() === data.val())"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "social": {
      "ownCodes": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{24}$/)"
        }
      },
      "codeLookup": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid && newData.val() === auth.uid))",
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/)"
        }
      },
      "relationships": {
        "$a": {
          "$b": {
            ".read": "auth != null && (auth.uid === $a || auth.uid === $b)",
            ".write": "auth != null && (auth.uid === $a || auth.uid === $b) && newData.exists() && $a !== $b",
            ".validate": "newData.hasChildren(['a','b','status','revision','updatedAt']) && newData.child('a').val() === $a && newData.child('b').val() === $b && (newData.child('status').val() === 'none' || newData.child('status').val() === 'pending' || newData.child('status').val() === 'friends') && newData.child('revision').isNumber() && newData.child('revision').val() >= 0 && newData.child('revision').val() % 1 === 0 && (!data.exists() || newData.child('revision').val() === data.child('revision').val() + 1) && (newData.child('status').val() !== 'pending' || (newData.hasChildren(['requestedBy','requesterName','requestedAt','expiresAt']) && (newData.child('requestedBy').val() === $a || newData.child('requestedBy').val() === $b) && newData.child('requestedAt').val() > now - 60000 && newData.child('expiresAt').val() > now && newData.child('expiresAt').val() <= now + 604800000)) && (newData.child('status').val() === 'pending' || (!newData.hasChildren(['requestedBy']) && !newData.hasChildren(['requesterName']) && !newData.hasChildren(['requestedAt']) && !newData.hasChildren(['expiresAt']))) && !root.child('social/blocks/' + $a + '/' + $b).exists() && !root.child('social/blocks/' + $b + '/' + $a).exists()"
          }
        }
      },
      "friends": {
        "$uid": {
          "$friendUid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)",
            ".validate": "newData.exists() && newData.hasChildren(['active','revision']) && newData.child('active').isBoolean() && newData.child('revision').isNumber() && newData.child('revision').val() >= 0"
          }
        }
      },
      "requests": {
        "$uid": {
          "$senderUid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $senderUid)",
            ".validate": "newData.exists() && newData.hasChildren(['active','revision']) && newData.child('active').isBoolean() && newData.child('revision').isNumber() && newData.child('revision').val() >= 0 && (newData.child('active').val() !== true || (newData.hasChildren(['expiresAt','displayName']) && newData.child('expiresAt').val() > now && newData.child('expiresAt').val() <= now + 604800000 && newData.child('displayName').isString() && newData.child('displayName').val().length >= 3 && newData.child('displayName').val().length <= 20))"
          }
        }
      },
      "sentRequests": {
        "$uid": {
          "$recipientUid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $recipientUid)",
            ".validate": "newData.exists() && newData.hasChildren(['active','revision']) && newData.child('active').isBoolean() && newData.child('revision').isNumber() && newData.child('revision').val() >= 0 && (newData.child('active').val() !== true || (newData.hasChildren(['expiresAt']) && newData.child('expiresAt').val() > now && newData.child('expiresAt').val() <= now + 604800000))"
          }
        }
      },
      "blocks": {
        "$uid": {
          "$blockedUid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && $uid !== $blockedUid",
            ".validate": "!newData.exists() || newData.val() === true"
          }
        }
      },
      "privacy": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['profile','characters']) && (newData.child('profile').val() === 'private' || newData.child('profile').val() === 'friends') && (newData.child('characters').val() === 'private' || newData.child('characters').val() === 'friends')"
        }
      },
      "profiles": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (root.child('social/privacy/' + $uid + '/profile').val() === 'friends' && root.child('social/friends/' + auth.uid + '/' + $uid + '/active').val() === true))",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['displayName']) && newData.child('displayName').isString() && newData.child('displayName').val().length >= 3 && newData.child('displayName').val().length <= 20"
        }
      },
      "characterViews": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (root.child('social/privacy/' + $uid + '/characters').val() === 'friends' && root.child('social/friends/' + auth.uid + '/' + $uid + '/active').val() === true))",
          ".write": "auth != null && auth.uid === $uid",
          "$classId": {
            ".validate": "($classId === 'knight' || $classId === 'mage') && newData.hasChildren(['level','xp','skillPoints']) && newData.child('level').isNumber() && newData.child('level').val() >= 1 && newData.child('level').val() <= 999 && newData.child('xp').isNumber() && newData.child('xp').val() >= 0 && newData.child('skillPoints').isNumber() && newData.child('skillPoints').val() >= 0"
          }
        }
      }
    },
    "$other": {
      ".validate": false
    }
  }
}
