{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'gender', 'xp'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24 && (!data.exists() || newData.val() === data.val())"
        },
        "gender": {
          ".validate": "(newData.val() === 'male' || newData.val() === 'female') && (!data.exists() || newData.val() === data.val())"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000 && newData.val() % 1 === 0 && (!data.exists() ? newData.val() === 0 : newData.val() >= data.val())"
        },
        "$other": {
          ".validate": false
        },
        "coopRewards": {
          "$partyId": {
            ".validate": "$partyId.matches(/^[a-f0-9]{32}$/) && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1023 && (!data.exists() || newData.val() >= data.val())"
          }
        },
        "skills": {
          ".validate": "newData.isString() && newData.val().matches(/^([0-3],){4}[0-3];(assault|engineer|logistics|medic|recon)$/)"
        },
        "armory": {
          ".validate": "newData.hasChildren(['scrap','fortify','plating','owned','equipped'])",
          "$other": {
            ".validate": false
          },
          "scrap": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "fortify": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 3"
          },
          "plating": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 3"
          },
          "owned": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 7"
          },
          "equipped": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 3"
          }
        }
      }
    },
    "parties": {
      "$partyId": {
        "hostId": {
          ".read": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/)",
          ".write": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && !data.exists() && newData.isString() && newData.val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "guestId": {
          ".read": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && root.child('parties').child($partyId).child('hostId').exists()",
          ".write": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && root.child('parties').child($partyId).child('hostId').exists() && ((auth.uid === root.child('parties').child($partyId).child('hostId').val() && !data.exists() && newData.isString() && newData.val() !== auth.uid && (!root.child('parties').child($partyId).child('startedGuest').exists() || root.child('parties').child($partyId).child('startedGuest').val() === newData.val()) && root.child('partyCodes').child(root.child('parties').child($partyId).child('inviteCode').val()).child('hostId').val() === auth.uid && root.child('partyCodes').child(root.child('parties').child($partyId).child('inviteCode').val()).child('partyId').val() === $partyId && root.child('partyCodes').child(root.child('parties').child($partyId).child('inviteCode').val()).child('requests').child(newData.val()).exists()) || (auth.uid === data.val() && !newData.exists()))",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "inputs": {
          "$uid": {
            ".read": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && (auth.uid === root.child('parties').child($partyId).child('hostId').val() || auth.uid === root.child('parties').child($partyId).child('guestId').val()) && ($uid === auth.uid || auth.uid === root.child('parties').child($partyId).child('hostId').val())",
            ".write": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && (auth.uid === $uid && (auth.uid === root.child('parties').child($partyId).child('hostId').val() || auth.uid === root.child('parties').child($partyId).child('guestId').val()))",
            ".validate": "newData.isString() && newData.val().length <= 4096"
          }
        },
        "views": {
          "$uid": {
            ".read": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && (auth.uid === $uid && (auth.uid === root.child('parties').child($partyId).child('hostId').val() || auth.uid === root.child('parties').child($partyId).child('guestId').val()))",
            ".write": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && (auth.uid === root.child('parties').child($partyId).child('hostId').val() && ($uid === root.child('parties').child($partyId).child('hostId').val() || $uid === root.child('parties').child($partyId).child('guestId').val() || $uid === root.child('parties').child($partyId).child('startedGuest').val())) && newData.exists()",
            ".validate": "newData.isString() && newData.val().length <= 262144"
          }
        },
        "presence": {
          "$uid": {
            ".read": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && (auth.uid === root.child('parties').child($partyId).child('hostId').val() || auth.uid === root.child('parties').child($partyId).child('guestId').val())",
            "$connection": {
              ".write": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && $connection.matches(/^[a-f0-9]{32}$/) && (auth.uid === $uid && (auth.uid === root.child('parties').child($partyId).child('hostId').val() || auth.uid === root.child('parties').child($partyId).child('guestId').val()))",
              ".validate": "newData.isNumber() && newData.val() <= now + 5000 && newData.val() >= now - 30000"
            }
          }
        },
        "$other": {
          ".validate": false
        },
        ".write": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && data.exists() && !newData.exists() && data.child('hostId').val() === auth.uid",
        "profiles": {
          "$uid": {
            ".read": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && (auth.uid === root.child('parties').child($partyId).child('hostId').val() || auth.uid === root.child('parties').child($partyId).child('guestId').val()) && ($uid === root.child('parties').child($partyId).child('hostId').val() || $uid === root.child('parties').child($partyId).child('guestId').val())",
            ".write": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && (auth.uid === $uid && (auth.uid === root.child('parties').child($partyId).child('hostId').val() || auth.uid === root.child('parties').child($partyId).child('guestId').val())) && (!newData.exists() || !root.child('parties').child($partyId).child('startedGuest').exists())",
            ".validate": "newData.hasChildren(['name','gender','level'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
            },
            "gender": {
              ".validate": "newData.val() === 'male' || newData.val() === 'female'"
            },
            "level": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000"
            },
            "$other": {
              ".validate": false
            },
            "skills": {
              ".validate": "newData.isString() && newData.val().matches(/^([0-3],){4}[0-3];(assault|engineer|logistics|medic|recon)$/)"
            },
            "loadout": {
              ".validate": "newData.isString() && newData.val().matches(/^([0-3],){2}[0-3]$/)"
            }
          }
        },
        "startedGuest": {
          ".read": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && (auth.uid === root.child('parties').child($partyId).child('hostId').val() || auth.uid === root.child('parties').child($partyId).child('guestId').val())",
          ".write": "auth != null && $partyId.matches(/^[a-f0-9]{32}$/) && auth.uid === root.child('parties').child($partyId).child('hostId').val() && !data.exists() && newData.isString() && newData.val() === root.child('parties').child($partyId).child('guestId').val() && root.child('parties').child($partyId).child('profiles').child(auth.uid).exists() && root.child('parties').child($partyId).child('profiles').child(newData.val()).exists()",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "inviteCode": {
          ".read": "auth != null && (auth.uid === root.child('parties').child($partyId).child('hostId').val() || auth.uid === root.child('parties').child($partyId).child('guestId').val())",
          ".write": "auth != null && auth.uid === root.child('parties').child($partyId).child('hostId').val() && !data.exists() && newData.isString() && newData.val().matches(/^[0-9]{4}$/)",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
        }
      }
    },
    "partyCodes": {
      "$code": {
        ".write": "auth != null && $code.matches(/^[0-9]{4}$/) && data.exists() && !newData.exists() && data.child('hostId').val() === auth.uid",
        "hostId": {
          ".read": "auth != null && $code.matches(/^[0-9]{4}$/)",
          ".write": "auth != null && $code.matches(/^[0-9]{4}$/) && !data.exists() && newData.isString() && newData.val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "partyId": {
          ".read": "auth != null && $code.matches(/^[0-9]{4}$/)",
          ".write": "auth != null && $code.matches(/^[0-9]{4}$/) && !data.exists() && auth.uid === root.child('partyCodes').child($code).child('hostId').val() && newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/) && root.child('parties').child(newData.val()).child('hostId').val() === auth.uid && root.child('parties').child(newData.val()).child('inviteCode').val() === $code",
          ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
        },
        "requests": {
          ".read": "auth != null && auth.uid === root.child('partyCodes').child($code).child('hostId').val()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && $code.matches(/^[0-9]{4}$/) && root.child('partyCodes').child($code).child('partyId').exists() && (auth.uid === $uid || (auth.uid === root.child('partyCodes').child($code).child('hostId').val() && !newData.exists()))",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').val() === root.child('players').child($uid).child('name').val()",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
