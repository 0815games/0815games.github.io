{
  "name": "pipboy3000",
  "version": "14.0.2",
  "private": true,
  "description": "Pip-Boy 3003 - Ödland-RPG im Browser",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
